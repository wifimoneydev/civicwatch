<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.civicwatch.app" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>CivicWatch</name>
    <description>Report and follow public safety incidents in your community.</description>
    <author email="omotunmiseawofadeju200@gmail.com">Daniel Awofadeju</author>
    <content src="index.html" />

    <!-- Network access: only the Supabase backend. The CSP in index.html enforces the same rule in the WebView. -->
    <access origin="https://*.supabase.co" />
    <access origin="wss://*.supabase.co" />
    <!-- The WebView never navigates away from the bundled app. -->
    <!-- External links (e.g. maps) may be handed to the system browser. -->
    <allow-intent href="https://*/*" />
    <allow-intent href="geo:*" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidInsecureFileModeEnabled" value="false" />
        <preference name="AndroidWindowSplashScreenBackground" value="#0B1F3A" />
        <!-- Photo picker / camera intents return content:// URIs; no broad storage permission needed. -->
    </platform>

    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff0b1f3a" />
    <preference name="StatusBarBackgroundColor" value="#0B1F3A" />
</widget>
